# ==============================================================================
# PROJECT AURA API (backend-node) - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy to backend-node/.env and fill in. NEVER commit real secrets.
# The server refuses to start if a required value is missing or invalid.

# --- Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development            # set to "production" on the server
# Number of reverse proxies in front of the API (nginx = 1). Needed for correct
# client IPs in rate limiting.
TRUST_PROXY=1
# Comma-separated list of allowed browser origins. REQUIRED in production.
# Example: https://aura.example.com,https://www.aura.example.com
CORS_ORIGINS=

# --- Database (REQUIRED) ------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/project_aura?retryWrites=true&w=majority

# --- Auth (REQUIRED) ----------------------------------------------------------
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Python ML service ---------------------------------------------------------
AURA_AI_URL=http://127.0.0.1:5000
AURA_AI_TIMEOUT_MS=10000
# v2 = HistGradientBoosting (default), v1 = legacy rollback. Must match the AI service.
MODEL_VERSION=v2

# --- Price estimation (optional; /api/pricing returns 503 without a key) --------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Email for password reset (optional) -------------------------------------
EMAIL_USER=
EMAIL_PASS=

# --- IGDB catalog sync script only (npm run games:sync) ----------------------
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
