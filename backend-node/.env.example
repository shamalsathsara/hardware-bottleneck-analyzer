# ==============================================================================
# PROJECT AURA BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with your environment-specific credentials.
# NEVER COMMIT REAL SECRETS TO VERSION CONTROL.

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/project_aura?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Python ML Microservice URL
AURA_AI_URL=http://127.0.0.1:5000
PYTHON_API_URL=http://127.0.0.1:5000

# Model Version Configuration (v2 = HistGradientBoosting Production Candidate, v1 = Legacy Rollback)
MODEL_VERSION=v2

# Email Delivery (Nodemailer - Optional Password Reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password_here

# IGDB Game Catalog Data Source (Twitch OAuth 2.0 Credentials - Backend Only)
IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here
