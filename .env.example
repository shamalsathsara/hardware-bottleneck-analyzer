# ==============================================================================
# PROJECT AURA - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env and fill in the values.

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/project_aura?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Python AI Microservice
PYTHON_API_URL=http://127.0.0.1:5000

# Email Delivery (Nodemailer)
EMAIL_USER=
EMAIL_PASS=

# IGDB Game Catalog Data Source (Twitch OAuth 2.0 Credentials)
# Backend only - Never expose to frontend
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
